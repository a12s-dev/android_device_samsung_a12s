# Bring-up only. Force insecure adb + verbose kernel log + logs on /cache.
on early-init
    setprop ro.adb.secure 0

on init
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

on boot
    start adbd
    write /proc/sys/kernel/printk 8

on post-fs
    mkdir /cache/bringup 0777 root root
    start a12s_dmesg

on property:sys.boot_completed=1
    start a12s_logcat

service a12s_dmesg /system/bin/sh -c "exec /system/bin/dmesg -w > /cache/bringup/dmesg.txt 2>&1"
    user root
    group root
    disabled
    oneshot

service a12s_logcat /system/bin/logcat -b all -v threadtime -f /cache/bringup/logcat.txt -r 4096 -n 4
    user root
    group log
    disabled