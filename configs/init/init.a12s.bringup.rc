# Bring-up only. Force insecure adb + verbose kernel log + periodic log dumps.
on early-init
    setprop ro.adb.secure 0

on init
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

on boot
    start adbd
    write /sys/fs/selinux/enforce 0
    write /proc/sys/kernel/printk 8
    mkdir /cache/bringup 0777 root root
    start a12s_logdump

service a12s_logdump /system/bin/sh /system/etc/a12s_logdump.sh
    class main
    user root
    group root log
    oneshot
