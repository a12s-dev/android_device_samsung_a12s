# Bring-up only. netd aborts right after start on this port; mirror its
# stderr into the kernel log so the abort message lands in /proc/last_kmsg.
# Remove this override before release.
service netd /system/bin/netd
    class main
    capabilities CHOWN DAC_OVERRIDE DAC_READ_SEARCH FOWNER IPC_LOCK KILL NET_ADMIN NET_BIND_SERVICE NET_RAW SETUID SETGID
    user root
    group root net_admin
    rlimit memlock 1073741824 1073741824
    socket dnsproxyd stream 0660 root inet
    socket mdns stream 0660 root system
    socket fwmarkd stream 0660 root inet
    onrestart restart zygote
    onrestart restart zygote_secondary
    updatable
    stdio_to_kmsg
    override

on post-fs-data
    exec - root root -- /system/bin/sh -c "dmesg > /cache/kmsg_postfs.txt 2>&1"

# bring-up: persist the userspace log to /cache (unencrypted, survives a hang)
on post-fs
    start bootlog
service bootlog /system/bin/logcat -b all -v threadtime -f /cache/bootlog.txt -r 4096 -n 4
    user root
    group root log
    disabled
    oneshot
